{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "eng/capabilities/ai-berkshire-skill-pack-sync.mjs",
        "eng/capabilities/probe-agent-host-session-electron.mjs",
        "eng/capabilities/agent-host-session-electron-probe.ts",
        "eng/capabilities/local-memory-settings-electron-probe.ts",
        "eng/capabilities/probe-shared-knowledge-live-electron.mjs",
        "eng/capabilities/shared-knowledge-live-electron-probe.ts",
        "eng/capabilities/shared-knowledge-live-utility-probe.ts",
        "eng/capabilities/team-model-port-electron-probe.ts",
        "eng/capabilities/team-model-port-utility-probe.ts",
        "eng/capabilities/team-worker-electron-probe.ts",
        "eng/capabilities/team-worker-utility-probe.ts",
        "eng/capabilities/team-index-deadline-probe.ts",
        "eng/packaging/probe-packaged-team-runtimes.mjs",
        "eng/packaging/probe-packaged-team-session.mjs",
        "eng/evals/openviking-agent-pilot/evaluation-extension.mjs"
      ]
    },
    "apps/agent-host": {
      "project": ["src/**/*.ts"]
    },
    "apps/desktop": {
      "entry": ["src/openviking-runtime-installer.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/renderer": {
      "entry": ["src/context-memory/ExperienceInspectorPanel.browser-fixture.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/domain": {
      "project": ["src/**/*.ts"]
    },
    "packages/pi-runtime": {
      "project": ["src/**/*.ts"]
    },
    "packages/openviking-pi-extension": {
      "entry": ["index.ts"],
      "project": ["**/*.{ts,mts,mjs}"],
      "ignore": ["**/*.d.mts"],
      "ignoreExportsUsedInFile": true,
      "ignoreIssues": {
        "client.ts": ["exports", "types"],
        "config.ts": ["exports", "types"],
        "diagnostics.ts": ["exports", "types"],
        "memory-owner-policy.ts": ["exports", "types"],
        "lib/**/*.mjs": ["exports", "types"],
        "shared/**/*.mjs": ["exports", "types"]
      }
    },
    "packages/pi-workspace-resources": {
      "entry": ["extensions/pi-rules-loader/index.ts"],
      "project": ["extensions/**/*.ts"]
    },
    "packages/protocol": {
      "project": ["src/**/*.ts"]
    }
  },
  "ignoreDependencies": [
    "@pi67/agent-host",
    "@pi67/desktop",
    "@pi67/renderer",
    "electron",
    "electron-builder",
    "pnpm"
  ],
  "ignoreBinaries": [
    "mkfifo",
    "pwsh"
  ]
}
