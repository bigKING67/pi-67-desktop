{
  "name": "@pi67/pi-runtime",
  "version": "0.1.0-alpha.7",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "corepack pnpm run build:runtime && corepack pnpm run build:performance",
    "build:runtime": "tsdown src/index.ts --format esm --dts --deps.never-bundle @earendil-works/pi-coding-agent --deps.never-bundle @earendil-works/pi-agent-core --deps.never-bundle @earendil-works/pi-ai",
    "build:performance": "tsdown src/session-jsonl-tail-performance-entry.ts --format esm --dts false --out-dir dist/performance --deps.never-bundle @earendil-works/pi-coding-agent --deps.never-bundle @earendil-works/pi-agent-core --deps.never-bundle @earendil-works/pi-ai",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.81.1",
    "@earendil-works/pi-ai": "0.81.1",
    "@earendil-works/pi-coding-agent": "0.81.1",
    "@pi67/domain": "workspace:*",
    "@pi67/extension-compat": "workspace:*",
    "@pi67/protocol": "workspace:*",
    "jsonc-parser": "3.3.1",
    "proper-lockfile": "4.1.2",
    "typebox": "1.3.6"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "tsdown": "0.22.13",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
