{
  "name": "@pi67/extension-compat",
  "version": "0.1.0-alpha.19",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts",
    "lint": "oxlint --type-aware --type-check --deny-warnings src",
    "test": "vitest run --root ../.. packages/extension-compat/src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "semver": "7.7.4"
  },
  "devDependencies": {
    "@types/semver": "7.7.1",
    "tsdown": "0.22.13",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
