{
  "name": "@pi67/protocol",
  "version": "0.1.0-alpha.24",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.mjs"
    },
    "./prompt-attachment-limits": {
      "types": "./src/prompt-attachment-limits.ts",
      "import": "./dist/prompt-attachment-limits.mjs"
    },
    "./prompt-stash-images": {
      "types": "./src/prompt-stash-images.ts",
      "import": "./dist/prompt-stash-images.mjs"
    },
    "./repository-environment-snapshot-validation": {
      "types": "./src/repository-environment-snapshot-validation.ts",
      "import": "./dist/repository-environment-snapshot-validation.mjs"
    },
    "./worktree-creation-result-validation": {
      "types": "./src/worktree-creation-result-validation.ts",
      "import": "./dist/worktree-creation-result-validation.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/prompt-attachment-limits.ts src/prompt-stash-images.ts src/repository-environment-snapshot-validation.ts src/worktree-creation-result-validation.ts --format esm --dts",
    "build:revision-inputs": "pnpm --filter @pi67/protocol... run build",
    "check:revision": "pnpm run build:revision-inputs && node scripts/generate-protocol-revision.mjs --check",
    "generate:revision": "pnpm run build:revision-inputs && node scripts/generate-protocol-revision.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pi67/domain": "workspace:*",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "tsdown": "0.22.13",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  }
}
