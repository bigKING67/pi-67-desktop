{
  "name": "@pi67/agent-host",
  "version": "0.1.0-alpha.13",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts src/package-worker.ts src/prompt-attachment-worker.ts --format esm --dts false --deps.never-bundle electron --deps.never-bundle @earendil-works/pi-coding-agent --deps.never-bundle @earendil-works/pi-agent-core",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@pi67/domain": "workspace:*",
    "@pi67/pi-runtime": "workspace:*",
    "@pi67/protocol": "workspace:*",
    "@tesseract.js-data/chi_sim": "1.0.0",
    "@tesseract.js-data/eng": "1.0.0",
    "chardet": "2.2.0",
    "file-type": "22.0.1",
    "mediainfo.js": "0.3.7",
    "music-metadata": "11.14.0",
    "officeparser": "7.5.1",
    "proper-lockfile": "4.1.2",
    "tar-stream": "3.2.0",
    "tesseract.js": "7.0.0",
    "yauzl": "3.4.0"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/proper-lockfile": "4.1.4",
    "@types/tar-stream": "3.1.4",
    "@types/yauzl": "2.10.3",
    "electron": "43.2.0",
    "tsdown": "0.22.13",
    "typescript": "7.0.2"
  }
}
